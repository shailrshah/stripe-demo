# Copy to .env and fill in. Test-mode values only — live keys are rejected.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Optional: npm start runs stripe listen itself and uses its secret. Only needed with STRIPE_LISTEN=false,
# where you run `stripe listen --all-snapshot --forward-to 127.0.0.1:3000/webhook` yourself and paste its whsec_ here.
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# STRIPE_LISTEN=false
PORT=3000
DATABASE_PATH=data/stripe-demo.db
# Only when sharing through a tunnel: the public origin, e.g. from `ngrok http 127.0.0.1:3000`.
# BASE_URL=https://example.ngrok-free.app
